<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="22dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Shelf Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/shelfTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTINUE WATCHING"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12"
            android:shadowColor="#B3000000"
            android:shadowRadius="3"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/shelfBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/shelf_badge_stremio"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.08"
            android:text="STREMIO" />
    </LinearLayout>

    <!-- Horizontal RecyclerView of Shelf Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelfRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="2dp"
        android:paddingEnd="36dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
